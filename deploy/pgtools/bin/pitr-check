#!/usr/bin/env bash
# pitr-check: CI proof of a recovery from the newest base backup and the WAL archive
# (ADR-0068 (l) to (o) as amended by ADR-0077 (a) to (e), design D10, D11 step 7).
#
# It runs in a temporary container of the image recipe-pgtools with container.backup_memory. The
# container mounts the WAL archive volume at /wal (writable). It mounts no secret and joins no network.
# The script opens no connection to db and writes nothing to db. CI runs the steps in this order:
# basebackup-once, the marker command ChangeOwnPassword, and then this script. The variable PITR_CI=1
# must be set, because the copy of the base backup uses free space on the WAL archive disk.
#
# Steps:
#   1. The gates: the environment, the path, the marker file, the lock, and a base backup.
#      The lock /wal/.lock is held to the exit, so basebackup-once cannot change the files.
#   2. The newest base backup (the last name of the grammar) is copied into a private scratch
#      directory below /wal/.pitr-scratch. The check of lib/recovery-steps.sh runs pg_verifybackup on the copy
#      and deletes the file backup_end_time from the copy (ADR-0106 (c)).
#   3. A scratch cluster starts from the copy. It recovers from the archive with the restore_command
#      of ADR-0068 (l) and the scratch.* settings of reliability.md 7.11. The steps of lib/recovery-steps.sh
#      pass these settings with pg_ctl -o (ADR-0106 (h)).
#   4. The checks of ADR-0068 (n) after the end of the recovery: the recovery is complete, exactly one
#      audit_log row has the chain_seq and the entry_hash of the marker, and the audit chain check
#      of data-model.md 4.9 passes.
# A trap stops the scratch server and deletes the scratch directory on each exit. The marker file, the
# lock file, the directory .pitr-scratch, and every base backup stay.
#
# Environment. The defaults are the production values. The test script sets the others.
#   PITR_CI            must be 1
#   PITR_MARKER_SEQ    the chain_seq of the marker row, ^[1-9][0-9]{0,18}$
#   PITR_MARKER_HASH   the entry_hash of the marker row as lower-case hex, ^[0-9a-f]{64}$
#   WAL_DIR            the WAL archive volume, default /wal, a plain absolute path
#   WALARCHIVE_LIB_DIR the directory of recovery-steps.sh and restore-steps.sh, default /etc/pgtools
set -euo pipefail
umask 077

export LC_ALL=C
# No variable of libpq may point a tool to another cluster.
unset PGHOST PGHOSTADDR PGPORT PGUSER PGPASSWORD PGPASSFILE PGSERVICE PGSERVICEFILE \
  PGDATABASE PGOPTIONS PGSSLMODE PGSSLROOTCERT PGSSLCERT PGSSLKEY PGCONNECT_TIMEOUT

JOB=pitr-check
MARKER_NAME=.walarchive-marker
LOCK_NAME=.lock
SCRATCH_NAME=.pitr-scratch
BASE_RE='^base_[0-9]{8}_[0-9]{6}$'
SEQ_RE='^[1-9][0-9]{0,18}$'
HASH_RE='^[0-9a-f]{64}$'
WAL_DIR_RE='^(/[A-Za-z0-9_.-]+)+$'
DB_NAME=recipe
SCRATCH_SUPERUSER=postgres
SCRATCH_PORT=5433 # scratch.port in reliability.md section 7.11
STOP_TIMEOUT_SECONDS=60 # scratch.stop_timeout in reliability.md section 7.11
START_TIMEOUT_SECONDS=600 # scratch.pitr_start_timeout in reliability.md section 7.11
READY_POLL_SECONDS=1 # pitr_check.ready_poll in reliability.md section 7.11
LOG_TAIL_LINES=20 # pitr_check.log_tail in reliability.md section 7.11

WAL_DIR=${WAL_DIR:-/wal}
LIB_DIR=${WALARCHIVE_LIB_DIR:-/etc/pgtools}
PITR_MARKER_SEQ=${PITR_MARKER_SEQ:-}
PITR_MARKER_HASH=${PITR_MARKER_HASH:-}

error_logged=0
newest=""
scratch=""
data_dir=""
socket_dir=""

# restore-steps.sh defines CHAIN_SQL, the one copy of the audit chain check. The load comes before the
# definitions below on purpose. The file also defines log, fail, and scratch_psql, and this script replaces them.
# The load failure uses echo, because fail does not exist yet.
# shellcheck source=../lib/restore-steps.sh
source "$LIB_DIR/restore-steps.sh" || { echo "pitr-check: cannot load restore-steps.sh" >&2; exit 1; }

# log <level> <message> [<extra JSON fields>]. Every value is a fixed text or a checked value.
log() {
  printf '{"timestamp":"%s","level":"%s","job":"%s","message":"%s"%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$JOB" "$2" "${3:+,$3}"
}

# fail <message> [<extra JSON fields>]: write the one ERROR line and stop.
fail() {
  error_logged=1
  log ERROR "$@"
  exit 1
}

# cleanup stops the scratch server and deletes the scratch directory of this run on each exit.
cleanup() {
  local status=$?
  trap - EXIT
  if [ -n "$data_dir" ] && [ -f "$data_dir/postmaster.pid" ]; then
    pg_ctl --pgdata="$data_dir" --mode=immediate --wait --timeout="$STOP_TIMEOUT_SECONDS" stop \
      >/dev/null 2>&1 || true
  fi
  case $scratch in
    "$WAL_DIR/$SCRATCH_NAME"/run.*)
      if [ -d "$scratch" ] && [ ! -L "$scratch" ]; then
        if ! rm -r -- "${scratch:?}"; then
          log ERROR "cannot delete the scratch directory of this run"
          status=1
        fi
      fi
      ;;
  esac
  if [ "$status" -ne 0 ] && [ "$error_logged" -eq 0 ]; then
    log ERROR "pitr check failed unexpectedly" "\"exit_code\":$status"
  fi
  exit "$status"
}
trap cleanup EXIT

# scratch_psql <sql>: one statement on the scratch cluster, over its private socket.
scratch_psql() {
  psql --no-psqlrc --quiet --no-align --tuples-only --no-password -v ON_ERROR_STOP=1 \
    --host="$socket_dir" --port="$SCRATCH_PORT" --username="$SCRATCH_SUPERUSER" \
    --dbname="$DB_NAME" --command="$1"
}

# select_base: the newest base backup is the last real directory of the grammar in byte order.
# A link, a file, or a name outside the grammar is no base backup (ADR-0077 (d)).
select_base() {
  local path name
  for path in "$WAL_DIR"/base/base_*; do
    name=${path##*/}
    [[ $name =~ $BASE_RE ]] && [ -d "$path" ] && [ ! -L "$path" ] || continue
    newest=$name
  done
  [ -n "$newest" ] || fail "no base backup in the WAL archive"
}

# write_scratch_config: the private socket directory, the access rule, and the signal file.
# The settings of the scratch cluster go to the server with pg_ctl -o (ADR-0106 (h)).
write_scratch_config() {
  # The socket directory is private, so a local connection needs no password.
  printf 'local all all trust\n' >"$scratch/pg_hba.conf"
  : >"$data_dir/recovery.signal"
}

# check_recovered: the checks of ADR-0068 (n) and ADR-0077 (e) on the recovered cluster.
check_recovered() {
  local state
  state=$(scratch_psql 'SELECT NOT pg_catalog.pg_is_in_recovery()') \
    || fail "cannot read the recovery state of the scratch cluster"
  [ "$state" = "t" ] || fail "the scratch cluster is still in recovery"
  recovery_check_marker "$PITR_MARKER_SEQ" "$PITR_MARKER_HASH"
  recovery_check_chain
}

# shellcheck source=../lib/recovery-steps.sh
source "$LIB_DIR/recovery-steps.sh" || fail "cannot load recovery-steps.sh"

# --- run ----------------------------------------------------------------------------------

# Step 1: the gates. A refused run starts no tool and writes no file.
[ "$#" -eq 0 ] || fail "usage: pitr-check"
[ "${PITR_CI:-}" = "1" ] \
  || fail "pitr-check copies a base backup onto the WAL archive disk and runs only in CI, set PITR_CI=1"
[[ $PITR_MARKER_SEQ =~ $SEQ_RE ]] || fail "PITR_MARKER_SEQ is missing or bad"
[[ $PITR_MARKER_HASH =~ $HASH_RE ]] || fail "PITR_MARKER_HASH is missing or bad"
[[ $WAL_DIR =~ $WAL_DIR_RE ]] || fail "WAL_DIR is not a plain absolute path"
case $WAL_DIR in
  */. | */./* | */.. | */../*) fail "WAL_DIR is not a plain absolute path" ;;
esac
if [ ! -f "$WAL_DIR/$MARKER_NAME" ] || [ -L "$WAL_DIR/$MARKER_NAME" ]; then
  fail "the marker file of the WAL archive disk is missing"
fi
exec 9>>"$WAL_DIR/$LOCK_NAME"
flock -n 9 || fail "another run holds the lock of the WAL archive"
select_base
log INFO "pitr check started" "\"base\":\"$newest\""

# Step 2: the copy of the newest base backup and its check.
mkdir -p -- "$WAL_DIR/$SCRATCH_NAME"
scratch=$(mktemp -d "$WAL_DIR/$SCRATCH_NAME/run.XXXXXX")
data_dir=$scratch/data
socket_dir=$scratch/sock
mkdir -- "$socket_dir"
cp -a -- "$WAL_DIR/base/$newest" "$data_dir" || fail "cannot copy the base backup"
chmod 0700 -- "$data_dir"
recovery_verify_copy "$data_dir" || fail "pg_verifybackup failed"
log INFO "base backup copied and checked" "\"base\":\"$newest\""

# Step 3: the scratch cluster recovers from the copy and the archive. The lock stays with this script.
start_deadline=$((SECONDS + START_TIMEOUT_SECONDS))
write_scratch_config
start_options="$(recovery_start_options "$WAL_DIR" "$socket_dir") -c hba_file=$scratch/pg_hba.conf"
recovery_start_server "$data_dir" "$scratch/server.log" "$socket_dir" "$start_options" "$start_deadline" \
  || fail "the scratch cluster did not finish the recovery"

# Step 4: the checks, after the end of the recovery.
check_recovered
log INFO "pitr check passed" "\"chain_seq\":$PITR_MARKER_SEQ,\"base\":\"$newest\""
