#!/usr/bin/env bash
# backup-entry: the entry of the container backup (design D9, ADR-0064, ADR-0066, ADR-0174 (v)).
# It checks the marker file, then the manifest key grammar and filesystem, then the crontab.
# A failed check stops the container.
# After these checks, it runs supercronic in the foreground as the main process.
# The crontab holds the nightly dump and the weekly restore test.
# The flag -passthrough-logs gives each JSON line of a job to the container log unchanged.
# Environment:
#   BACKUP_DIR                the backup disk, default /backups
#   BACKUP_CRONTAB            the crontab, default /etc/pgtools/crontab.backup
#   BACKUP_MANIFEST_KEY_FILE  the manifest key file, default /run/secrets/backup_manifest_key
set -euo pipefail
umask 077

JOB=backup-entry
MARKER_NAME=.backup-marker
BACKUP_DIR=${BACKUP_DIR:-/backups}
CRONTAB=${BACKUP_CRONTAB:-/etc/pgtools/crontab.backup}
MANIFEST_KEY_FILE=${BACKUP_MANIFEST_KEY_FILE:-/run/secrets/backup_manifest_key}

# log <level> <message> [<extra JSON fields>]. Every value is fixed text or a checked number.
log() {
  printf '{"timestamp":"%s","level":"%s","job":"%s","message":"%s"%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$JOB" "$2" "${3:+,$3}"
}

if [ ! -f "$BACKUP_DIR/$MARKER_NAME" ]; then
  log ERROR "the marker file of the backup disk is missing"
  exit 1
fi

# shellcheck source=../lib/manifest-tag.sh
if ! source /etc/pgtools/manifest-tag.sh 2>/dev/null; then
  log ERROR "cannot load the manifest tag library"
  exit 1
fi
if ! fault=$(manifest_tag_key_ids "$MANIFEST_KEY_FILE" 2>&1 >/dev/null); then
  IFS=$'\t' read -r message line < <(manifest_tag_message "$fault")
  log ERROR "$message" "${line:+\"line\":$line}"
  exit 1
fi
if ! fault=$(manifest_tag_check_location "$MANIFEST_KEY_FILE" 2>&1); then
  IFS=$'\t' read -r message line < <(manifest_tag_message "$fault")
  log ERROR "$message" "${line:+\"line\":$line}"
  exit 1
fi

if [ ! -r "$CRONTAB" ]; then
  log ERROR "the crontab file is missing"
  exit 1
fi

log INFO "scheduler started"
exec supercronic -json -passthrough-logs "$CRONTAB"
