#!/usr/bin/env bash
# restore-test: restore the newest backup set into a private scratch cluster and check it.
#
# Source: ADR-0067 (c) to (l) as amended by ADR-0076 and ADR-0078, ADR-0066, ADR-0074, ADR-0033,
# reliability.md sections 7.7 and 7.11, design D10. The service backup runs it every Sunday
# (supercronic). Before a release, the operator runs: docker compose exec backup restore-test
#
# Steps (the numbers are the steps of ADR-0067):
#   1. The marker, the lock, and the newest complete set (ADR-0074 (c)).
#      Copy the globals file once into the private tmpfs directory with mode 0600.
#      Run sha256sum -c --strict on the manifest and compare the copy's hash with its manifest entry.
#      A mismatch stops the test before any PostgreSQL tool runs.
#      Check the counts file and the globals copy, including the role grammar of ADR-0095.
#   2. Each FUNCTION, TRIGGER, and EVENT TRIGGER entry of pg_restore --list names a line of
#      restore-code.expected (ADR-0076 (b)). An unknown entry stops the test. An entry of the
#      kind PROCEDURE, AGGREGATE, MATERIALIZED VIEW, or OPERATOR stops it too (ADR-0078 (b)).
#   3. A private scratch cluster on the backup disk, the checked globals copy, and a random password for each login role.
#      psql reads only the private copy, so a later change on the backup disk cannot replace its SQL.
#   4. pg_restore --section=pre-data. The lines of restore-code.sql for the kinds FUNCTION, CHECK,
#      and GENERATED must equal restore-code.expected (ADR-0076 (c)).
#   5. pg_restore --section=data and then post-data. The lines of every kind must equal the file.
#   6. The row counts of the counts file and of the restored tables are equal in both directions.
#   7. The audit chain check of data-model.md section 4.9.
#   8. Each login role logs in over 127.0.0.1 with its password. A wrong password must fail.
#   9. One JSON result line. A failed step writes one ERROR line and exits with 1.
# A trap stops the scratch server and deletes the scratch directory on each exit. The marker,
# the lock, the directory .scratch, and every file of a set stay.
#
# The test reads no production password. No tool reaches the production cluster: the script
# clears the variables PG* and every call names the private socket or 127.0.0.1.
# A password never enters argv or a shell variable. It lives in a file of the tmpfs.
#
# Environment. The defaults are the production values. The test script sets the others.
#   BACKUP_DIR          the backup disk, default /backups
#   BACKUP_PGPASS_DIR   the tmpfs for the secret files, default /run/pgpass
#   RESTORE_CODE_DIR    the directory of restore-code.sql and restore-code.expected, default /etc/pgtools
#   RESTORE_GLOBALS_DIR the directory of globals-grammar.sh and restore-steps.sh, default /etc/pgtools
#   PGDATABASE          the name of the database in the dump, default recipe
set -euo pipefail
umask 077

export LC_ALL=C

JOB=restore-test
MARKER_NAME=.backup-marker
SCRATCH_NAME=.scratch
LOCK_NAME=.lock
SCRATCH_PORT=5433 # scratch.port of reliability.md section 7.11 (ADR-0077 (g))
START_TIMEOUT_SECONDS=60 # scratch.restore_start_timeout of 7.11: the start of the scratch server
STOP_TIMEOUT_SECONDS=60 # scratch.stop_timeout of 7.11: the stop of the scratch server
DETAIL_LENGTH=160 # restore_test.detail_length of 7.11: the characters of a tool message in an ERROR line
# scratch.* of reliability.md section 7.11 (ADR-0067 (e), (f)).
SCRATCH_SETTINGS=(
  shared_buffers=64MB maintenance_work_mem=64MB max_connections=10
  max_parallel_workers_per_gather=0 max_parallel_maintenance_workers=0
  fsync=off wal_level=minimal max_wal_senders=0
)

BACKUP_DIR=${BACKUP_DIR:-/backups}
PGPASS_DIR=${BACKUP_PGPASS_DIR:-/run/pgpass}
CODE_DIR=${RESTORE_CODE_DIR:-/etc/pgtools}
DB_NAME=${PGDATABASE:-recipe}
# No variable of libpq may point a tool to the production cluster.
unset PGHOST PGHOSTADDR PGPORT PGUSER PGPASSWORD PGPASSFILE PGSERVICE PGSERVICEFILE \
  PGDATABASE PGOPTIONS PGSSLMODE PGSSLROOTCERT PGSSLCERT PGSSLKEY PGCONNECT_TIMEOUT

# The steps that restore-test shares with restore-volume (ADR-0103 (j)). The file sets no value of 7.11.
# shellcheck source=../lib/restore-steps.sh
source "${RESTORE_GLOBALS_DIR:-/etc/pgtools}/restore-steps.sh" \
  || { echo "restore-test: cannot load restore-steps.sh" >&2; exit 1; }

error_logged=0
work_dir=""
scratch=""
data_dir=""
socket_dir=""
superuser=""
server_started=0
set_stamp=""
base=""
manifest_name=""
dump_path=""
globals_path=""
globals_copy=""
counts_path=""
table_count=0
login_roles=()

# stop_server <data directory>: stop a scratch server at once. It never needs a clean shutdown.
stop_server() {
  pg_ctl --pgdata="$1" --mode=immediate --wait --timeout="$STOP_TIMEOUT_SECONDS" stop >/dev/null 2>&1
}

# remove_dir <directory> <parent>: delete one directory of this script below its parent.
remove_dir() {
  case $1 in
    "$2"/run.*) ;;
    *) return 1 ;;
  esac
  if [ -d "$1" ] && [ ! -L "$1" ]; then
    rm -r -- "${1:?}"
  fi
}

# cleanup runs on each exit. The secret files go first and on a best effort.
cleanup() {
  local status=$? stopped=1
  trap - EXIT
  if [ -n "$work_dir" ] && ! remove_dir "$work_dir" "$PGPASS_DIR"; then
    log ERROR "cannot delete the password directory of this run"
    status=1
  fi
  if [ "$server_started" -eq 1 ] || { [ -n "$data_dir" ] && [ -f "$data_dir/postmaster.pid" ]; }; then
    stop_server "$data_dir" || stopped=0
  fi
  if [ "$stopped" -eq 0 ]; then
    log ERROR "cannot stop the scratch server of this run"
    status=1
  elif [ -n "$scratch" ] && ! remove_dir "$scratch" "$BACKUP_DIR/$SCRATCH_NAME"; then
    log ERROR "cannot delete the scratch directory of this run"
    status=1
  fi
  if [ "$status" -ne 0 ] && [ "$error_logged" -eq 0 ]; then
    log ERROR "restore test failed unexpectedly" "\"exit_code\":$status"
  fi
  exit "$status"
}
trap cleanup EXIT
# A signal must run the trap, so the server stops and the scratch directory goes.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

# is_scratch_postmaster <data directory>: succeeds only when the PID in postmaster.pid is a postgres
# process that was started for that data directory. pg_ctl stop sends a signal to that PID. After a
# restart of the container, another process can hold the PID of a stale file, and it gets no signal.
# The command line of a postmaster is "<path>/postgres -D <data directory>".
is_scratch_postmaster() {
  local pid arg args=()
  pid=$(sed -n '1p' -- "$1/postmaster.pid") || return 1
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  mapfile -d '' -t args <"/proc/$pid/cmdline" || return 1
  [ "${args[0]-}" != "" ] && [ "${args[0]##*/}" = postgres ] || return 1
  for arg in "${args[@]:1}"; do
    if [ "$arg" = "$1" ]; then
      return 0
    fi
  done
  return 1
}

# delete_stale_runs: a killed run leaves a directory run.* below .scratch. The lock proves that
# no other run lives, so every such directory is stale. A symbolic link is never followed.
# The script stops a server only when is_scratch_postmaster agrees. Else it deletes the directory.
delete_stale_runs() {
  local dir
  for dir in "$BACKUP_DIR/$SCRATCH_NAME"/run.*; do
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then
      continue
    fi
    if [ -f "$dir/data/postmaster.pid" ] && is_scratch_postmaster "$dir/data"; then
      stop_server "$dir/data" || true
    fi
    remove_dir "$dir" "$BACKUP_DIR/$SCRATCH_NAME" || fail "cannot delete a stale scratch directory"
    log INFO "stale scratch directory deleted" "\"directory\":\"$(clean "${dir##*/}")\""
  done
}

# start_cluster: step 3. initdb with the arguments of reliability.md 7.1 and a private socket.
start_cluster() {
  mkdir -p -- "$BACKUP_DIR/$SCRATCH_NAME"
  scratch=$(mktemp -d "$BACKUP_DIR/$SCRATCH_NAME/run.XXXXXX") || fail "cannot create the scratch directory"
  data_dir=$scratch/data
  socket_dir=$scratch/sock
  mkdir -m 0700 -- "$socket_dir"
  superuser=$(id -un) || fail "cannot read the name of the system user"
  random_secret "$work_dir/superuser.pw"
  initdb --pgdata="$data_dir" --username="$superuser" --auth-local=peer \
    --auth-host=scram-sha-256 --pwfile="$work_dir/superuser.pw" --data-checksums \
    --lc-collate=C --lc-ctype=C.UTF-8 >/dev/null 2>"$work_dir/initdb.err" \
    || fail "initdb failed" "\"detail\":\"$(tool_detail "$work_dir/initdb.err")\""
  {
    printf '%s\n' "${SCRATCH_SETTINGS[@]}"
    printf '%s\n' "listen_addresses='127.0.0.1'" "port=$SCRATCH_PORT" \
      "unix_socket_directories='$socket_dir'" "unix_socket_permissions=0700"
  } >>"$data_dir/postgresql.conf"
  server_started=1
  # Descriptor 9 holds the lock. The server must not keep it.
  pg_ctl --pgdata="$data_dir" --log="$scratch/server.log" --wait \
    --timeout="$START_TIMEOUT_SECONDS" start >/dev/null 2>"$work_dir/pg_ctl.err" 9>&- \
    || fail "the scratch server did not start" "\"detail\":\"$(tool_detail "$work_dir/pg_ctl.err")\""
}

# set_passwords: a random password for each login role of the globals file. The statement goes
# to the server through standard input, so the password is in no argument.
set_passwords() {
  local roles role
  roles=$(scratch_psql --dbname=postgres --command="SELECT rolname FROM pg_catalog.pg_roles WHERE rolcanlogin AND rolname <> current_user ORDER BY rolname") \
    || fail "cannot list the login roles"
  while IFS= read -r role; do
    [ -n "$role" ] || continue
    [[ $role =~ $ROLE_GRAMMAR ]] || fail "a login role has a name outside the pattern"
    login_roles+=("$role")
  done <<<"$roles"
  [ "${#login_roles[@]}" -gt 0 ] || fail "the restored cluster has no login role"
  for role in "${login_roles[@]}"; do
    random_secret "$work_dir/pw.$role"
    { printf "ALTER ROLE %s PASSWORD '" "$role"; cat -- "$work_dir/pw.$role"; printf "';\n"; } \
      | scratch_psql --dbname=postgres || fail "cannot set the password of a login role" "\"role\":\"$role\""
  done
}

# write_pgpass <file> <role> <password file>: one libpq line. The password is hex text.
write_pgpass() {
  { printf '127.0.0.1:%s:%s:%s:' "$SCRATCH_PORT" "$DB_NAME" "$2"; cat -- "$3"; printf '\n'; } >"$1"
}

# try_login <role> <pgpass file>: 0 the server accepted the password, 1 it refused the password,
# 2 another error. A role without CONNECT on the database passes the authentication first.
try_login() {
  env PGPASSFILE="$2" psql --no-psqlrc --quiet --no-align --tuples-only --no-password \
    --host=127.0.0.1 --port="$SCRATCH_PORT" --username="$1" --dbname="$DB_NAME" \
    --command='SELECT 1' >/dev/null 2>"$work_dir/login.err" && return 0
  if grep -q 'password authentication failed' "$work_dir/login.err"; then
    return 1
  fi
  if grep -q 'permission denied for database' "$work_dir/login.err"; then
    return 0
  fi
  return 2
}

# check_logins: step 8. The right password works and a wrong password fails, for each role.
check_logins() {
  local role status
  random_secret "$work_dir/wrong.pw"
  for role in "${login_roles[@]}"; do
    write_pgpass "$work_dir/pgpass.good" "$role" "$work_dir/pw.$role"
    write_pgpass "$work_dir/pgpass.bad" "$role" "$work_dir/wrong.pw"
    status=0
    try_login "$role" "$work_dir/pgpass.good" || status=$?
    [ "$status" -eq 0 ] || fail "a login with the right password failed" "\"role\":\"$role\""
    status=0
    try_login "$role" "$work_dir/pgpass.bad" || status=$?
    [ "$status" -ne 0 ] || fail "a login with a wrong password succeeded" "\"role\":\"$role\""
    [ "$status" -eq 1 ] || fail "a login with a wrong password gave an unexpected error" "\"role\":\"$role\""
  done
}

# --- run ----------------------------------------------------------------------------------

[ "$#" -eq 0 ] || fail "usage: restore-test"
case $BACKUP_DIR in
  /?*) ;;
  *) fail "BACKUP_DIR must be an absolute path" ;;
esac
[[ $DB_NAME =~ $ROLE_GRAMMAR ]] || fail "bad PGDATABASE"

# Step 1: the gates. A refused run starts no tool.
[ -f "$BACKUP_DIR/$MARKER_NAME" ] || fail "the marker file of the backup disk is missing"
for file in restore-code.sql restore-code.expected; do
  [ -f "$CODE_DIR/$file" ] || fail "restore-code.sql or restore-code.expected is missing"
done
mkdir -p -- "$BACKUP_DIR/$SCRATCH_NAME"
exec 9>>"$BACKUP_DIR/$SCRATCH_NAME/$LOCK_NAME"
flock -n 9 || fail "another restore test holds the lock"
delete_stale_runs
[ -d "$PGPASS_DIR" ] || fail "the directory of the secret files is missing"
work_dir=$(mktemp -d "$PGPASS_DIR/run.XXXXXX") || fail "cannot create the directory of the secret files"
select_set
check_manifest
check_counts
check_globals
log INFO "restore test started" "\"set\":\"$base\""

# Step 2: the names of the dump.
check_names

# Step 3: the scratch cluster, the globals file, and the passwords.
start_cluster
restore_globals
set_passwords

# Step 4: pre-data, then the code of the kinds that pre-data holds.
restore_section pre-data
check_database
compare_code pre-data "$PRE_DATA_KINDS"

# Step 5: the data and post-data, then the code of every kind.
restore_section data
restore_section post-data
compare_code post-data "$ALL_KINDS"

# Steps 6 to 8: the row counts, the audit chain, and the logins.
compare_counts
check_chain
check_logins

# Step 9: the result line.
log INFO "restore test passed" "\"set\":\"$base\",\"tables\":$table_count,\"roles\":${#login_roles[@]}"
