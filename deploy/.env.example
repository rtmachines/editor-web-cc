# Values of the Compose interpolation (ADR-0062 (i)). Copy this file to deploy/.env.
# The file holds eight values and no password, key, or token. The application never reads it.
# Each value is required. Compose stops when one is missing (:? in compose.yaml).

# The version tag of the images recipe-server and recipe-pgtools (ADR-0064).
RECIPE_VERSION=0.1.0

# Absolute host directories on the second disk (ADR-0066 (a), ADR-0068).
# Each directory holds its marker file before the first start (ADR-0074 (a)).
RECIPE_BACKUP_DIR=/srv/recipe-editor/backups
RECIPE_WALARCHIVE_DIR=/srv/recipe-editor/walarchive

# The directory of the secret files. It lies outside the repository (ADR-0062 (l)).
RECIPE_SECRETS_DIR=/etc/recipe-editor/secrets

# The network backend (ADR-0065 (k)). A change of the subnet edits these three values together.
# PROXY_ADDRESS lies inside COMPOSE_SUBNET and outside COMPOSE_IP_RANGE.
COMPOSE_SUBNET=172.28.0.0/16
COMPOSE_IP_RANGE=172.28.1.0/24
PROXY_ADDRESS=172.28.0.2

# The host name or the IP address of the site. It has no scheme and no port (Caddyfile).
SITE_ADDRESS=recipe.example.com
