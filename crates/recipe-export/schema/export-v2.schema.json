{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recipe-editor:export-document:schema-version:2",
  "title": "Export document v2 (unit scope) of the recipe editor",
  "description": "This file is the source of truth of the export document (ADR-0019). api.md section 6 describes it. api.md section 6.4 describes the unit scope. A new field needs schema_version 3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exported_at",
    "exported_by",
    "loadable",
    "content_sha256",
    "scope_sha256",
    "machine",
    "recipe",
    "version",
    "scope",
    "types",
    "parameters"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "exported_at": { "$ref": "#/$defs/utc_time" },
    "exported_by": { "$ref": "#/$defs/login" },
    "loadable": { "type": "boolean" },
    "content_sha256": {
      "description": "The stored lower-case hex SHA-256 of the whole version. It does not describe the parameters of this document.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_sha256": {
      "description": "Lower-case hex SHA-256 of the RFC 8785 canonical form of the scope hashed body (api.md section 6.4).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine": { "$ref": "#/$defs/machine" },
    "recipe": { "$ref": "#/$defs/recipe" },
    "version": { "$ref": "#/$defs/version" },
    "scope": { "$ref": "#/$defs/scope" },
    "types": {
      "description": "Ordered by id, compared byte by byte (api.md section 6.3).",
      "type": "array",
      "items": { "$ref": "#/$defs/type_entry" }
    },
    "parameters": {
      "description": "The parameters of the scope unit and of its descendant units, ordered by unit_path, then tag (api.md sections 6.3 and 6.4).",
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    }
  },
  "allOf": [
    {
      "description": "A Retired version has loadable false. An Approved version can have either value (ADR-0119 (g)).",
      "if": {
        "required": ["version"],
        "properties": {
          "version": {
            "required": ["status"],
            "properties": { "status": { "const": "Retired" } }
          }
        }
      },
      "then": { "properties": { "loadable": { "const": false } } }
    },
    {
      "description": "An S7 address is required on S7_300 (A31).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "S7_300" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "s7_address": { "type": "string" } } }
          }
        }
      }
    },
    {
      "description": "An S7 address is not allowed on CodesysIec and TwinCat3 (A31).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "enum": ["CodesysIec", "TwinCat3"] } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "s7_address": { "type": "null" } } }
          }
        }
      }
    }
,
    {
      "description": "Type references and string lengths on CodesysIec (ADR-0208 (a), (b)).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "CodesysIec" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_CodesysIec" } } }
          },
          "types": {
            "items": {
              "properties": {
                "element_type_id": { "$ref": "#/$defs/type_ref_CodesysIec" },
                "members": { "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_CodesysIec" } } } }
              },
              "allOf": [
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "STRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 255 } } }
                },
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "WSTRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 255 } } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Type references and string lengths on TwinCat3 (ADR-0208 (a), (b)).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "TwinCat3" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_TwinCat3" } } }
          },
          "types": {
            "items": {
              "properties": {
                "element_type_id": { "$ref": "#/$defs/type_ref_TwinCat3" },
                "members": { "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_TwinCat3" } } } }
              },
              "allOf": [
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "STRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 255 } } }
                },
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "WSTRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 255 } } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Type references and string lengths on S7_1200 (ADR-0208 (a), (b)).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "S7_1200" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_1200" } } }
          },
          "types": {
            "items": {
              "properties": {
                "element_type_id": { "$ref": "#/$defs/type_ref_S7_1200" },
                "members": { "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_1200" } } } }
              },
              "allOf": [
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "STRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 254 } } }
                },
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "WSTRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 16382 } } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Type references and string lengths on S7_1500 (ADR-0208 (a), (b)).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "S7_1500" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_1500" } } }
          },
          "types": {
            "items": {
              "properties": {
                "element_type_id": { "$ref": "#/$defs/type_ref_S7_1500" },
                "members": { "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_1500" } } } }
              },
              "allOf": [
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "STRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 254 } } }
                },
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "WSTRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 16382 } } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Type references and string lengths on S7_300 (ADR-0208 (a), (b)).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "S7_300" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_300" } } }
          },
          "types": {
            "items": {
              "properties": {
                "element_type_id": { "$ref": "#/$defs/type_ref_S7_300" },
                "members": { "items": { "properties": { "type_id": { "$ref": "#/$defs/type_ref_S7_300" } } } }
              },
              "allOf": [
                {
                  "if": { "required": ["kind", "name"], "properties": { "kind": { "const": "Primitive" }, "name": { "const": "STRING" } } },
                  "then": { "properties": { "string_length": { "maximum": 254 } } }
                },
                {
                  "if": { "required": ["kind"], "properties": { "kind": { "const": "Primitive" } } },
                  "then": { "properties": { "name": { "const": "STRING" } } }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utc_time": {
      "description": "RFC 3339 time in UTC with whole seconds and the suffix Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "login": {
      "description": "Login of a user (domain-model.md section 2).",
      "type": "string",
      "pattern": "^[a-z0-9._-]{3,64}$"
    },
    "name_text": {
      "description": "A name at export time. Names are not in the hash.",
      "type": "string",
      "minLength": 1
    },
    "decimal_or_null": {
      "description": "Canonical decimal text of reliability.md section 4.4, or null.",
      "type": ["string", "null"],
      "pattern": "^(0|-?[1-9][0-9]*(\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"
    },
    "identifier_name": {
      "description": "Name of a struct or of a struct member (domain-model.md section 2).",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "type_ref": {
      "description": "The primitive name for a primitive without a length. A types[].id for every other type.",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "LWORD",
            "SINT", "USINT", "INT", "UINT", "DINT", "UDINT", "LINT", "ULINT",
            "REAL", "LREAL", "CHAR", "WCHAR",
            "TIME", "LTIME", "DATE", "LDATE", "TIME_OF_DAY", "LTOD",
            "DATE_AND_TIME", "LDT", "DTL", "S5TIME"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "value": {
      "description": "A ParameterValue tree. A leaf is a string or a boolean. A JSON number and null are not allowed.",
      "anyOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    },
    "type_ref_CodesysIec": {
      "description": "A type_ref on CodesysIec: the primitive names with yes in the column of data-model.md section 7, except STRING and WSTRING (ADR-0208 (a)).",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "LWORD", "SINT", "USINT", "INT",
            "UINT", "DINT", "UDINT", "LINT", "ULINT", "REAL", "LREAL", "TIME",
            "LTIME", "DATE", "LDATE", "TIME_OF_DAY", "LTOD", "DATE_AND_TIME",
            "LDT"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "type_ref_TwinCat3": {
      "description": "A type_ref on TwinCat3: the primitive names with yes in the column of data-model.md section 7, except STRING and WSTRING (ADR-0208 (a)).",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "LWORD", "SINT", "USINT", "INT",
            "UINT", "DINT", "UDINT", "LINT", "ULINT", "REAL", "LREAL", "TIME",
            "LTIME", "DATE", "LDATE", "TIME_OF_DAY", "LTOD", "DATE_AND_TIME",
            "LDT"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "type_ref_S7_1200": {
      "description": "A type_ref on S7_1200: the primitive names with yes in the column of data-model.md section 7, except STRING and WSTRING (ADR-0208 (a)).",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "SINT", "USINT", "INT", "UINT",
            "DINT", "UDINT", "REAL", "LREAL", "CHAR", "WCHAR", "TIME", "DATE",
            "TIME_OF_DAY", "DTL"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "type_ref_S7_1500": {
      "description": "A type_ref on S7_1500: the primitive names with yes in the column of data-model.md section 7, except STRING and WSTRING (ADR-0208 (a)).",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "LWORD", "SINT", "USINT", "INT",
            "UINT", "DINT", "UDINT", "LINT", "ULINT", "REAL", "LREAL", "CHAR",
            "WCHAR", "TIME", "LTIME", "DATE", "TIME_OF_DAY", "LTOD",
            "DATE_AND_TIME", "LDT", "DTL", "S5TIME"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "type_ref_S7_300": {
      "description": "A type_ref on S7_300: the primitive names with yes in the column of data-model.md section 7, except STRING and WSTRING (ADR-0208 (a)).",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "INT", "DINT", "REAL", "CHAR", "TIME",
            "DATE", "TIME_OF_DAY", "DATE_AND_TIME", "S5TIME"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "primitive_names_decimal": {
      "description": "The primitives of the classes numeric, duration, and instant (ADR-0208 (d)).",
      "enum": [
        "BYTE", "WORD", "DWORD", "LWORD", "SINT", "USINT", "INT", "UINT",
        "DINT", "UDINT", "LINT", "ULINT", "REAL", "LREAL", "TIME", "LTIME",
        "S5TIME", "DATE", "LDATE", "TIME_OF_DAY", "LTOD", "DATE_AND_TIME",
        "LDT", "DTL"
      ]
    },
    "primitive_names_char": {
      "description": "The primitives of the class char (ADR-0208 (d)).",
      "enum": ["CHAR", "WCHAR"]
    },
    "decimal_text": {
      "description": "Canonical decimal text of reliability.md section 4.4.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*(\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"
    },
    "char_text": {
      "description": "A CHAR or WCHAR value: a string with one character.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "plc_platform"],
      "properties": {
        "code": { "type": "string", "pattern": "^M[1-9][0-9]{0,6}$" },
        "name": { "$ref": "#/$defs/name_text" },
        "plc_platform": {
          "enum": ["CodesysIec", "TwinCat3", "S7_1200", "S7_1500", "S7_300"]
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_number", "name"],
      "properties": {
        "reference_number": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,49}$" },
        "name": { "$ref": "#/$defs/name_text" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "status", "approved_at", "approved_by"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["Approved", "Retired"] },
        "approved_at": { "$ref": "#/$defs/utc_time" },
        "approved_by": { "$ref": "#/$defs/login" }
      }
    },
    "scope": {
      "description": "The unit of the route (api.md section 6.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_path"],
      "properties": {
        "unit_path": { "$ref": "#/$defs/unit_path" }
      }
    },
    "unit_path": {
      "description": "UnitPath: U and 1 to 5 segments, each 1 to 64 (A30).",
      "type": "string",
      "pattern": "^U([1-9]|[1-5][0-9]|6[0-4])(\\.([1-9]|[1-5][0-9]|6[0-4])){0,4}$"
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "upper": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_id"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier_name" },
        "type_id": { "$ref": "#/$defs/type_ref" }
      }
    },
    "type_entry": {
      "description": "One entry of types[]. element_type_id and dimensions exist only for Array. members exists only for Struct.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision", "kind", "string_length"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": ["string", "null"] },
        "revision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["Primitive", "Array", "Struct"] },
        "string_length": { "type": ["integer", "null"], "minimum": 1, "maximum": 16382 },
        "element_type_id": { "$ref": "#/$defs/type_ref" },
        "dimensions": {
          "description": "One to 3 dimensions (A38).",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "members": {
          "description": "Ordered by the member ordinal.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/member" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Primitive" } } },
          "then": {
            "properties": {
              "name": { "enum": ["STRING", "WSTRING"] },
              "revision": { "const": 1 },
              "string_length": { "type": "integer" }
            },
            "not": {
              "anyOf": [
                { "required": ["element_type_id"] },
                { "required": ["dimensions"] },
                { "required": ["members"] }
              ]
            }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Array" } } },
          "then": {
            "required": ["element_type_id", "dimensions"],
            "properties": {
              "name": { "type": "null" },
              "revision": { "const": 1 },
              "string_length": { "type": "null" }
            },
            "not": { "required": ["members"] }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Struct" } } },
          "then": {
            "required": ["members"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier_name" },
              "string_length": { "type": "null" }
            },
            "not": {
              "anyOf": [
                { "required": ["element_type_id"] },
                { "required": ["dimensions"] }
              ]
            }
          }
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf_path", "min", "max", "max_length"],
      "properties": {
        "leaf_path": {
          "description": "LeafPath grammar of domain-model.md section 2.1.",
          "type": "string",
          "pattern": "^(\\.[A-Za-z_][A-Za-z0-9_]{0,63}|\\[-?[0-9]{1,10}(,-?[0-9]{1,10}){0,2}\\]|\\[\\*\\])*$"
        },
        "min": { "$ref": "#/$defs/decimal_or_null" },
        "max": { "$ref": "#/$defs/decimal_or_null" },
        "max_length": { "$ref": "#/$defs/decimal_or_null" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_path", "tag", "key", "name_en", "type_id", "s7_address", "limits", "value"],
      "properties": {
        "unit_path": { "$ref": "#/$defs/unit_path" },
        "tag": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "key": { "$ref": "#/$defs/uuid" },
        "name_en": { "$ref": "#/$defs/name_text" },
        "type_id": { "$ref": "#/$defs/type_ref" },
        "s7_address": { "type": ["string", "null"], "pattern": "^DB(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.(?:DBX(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])\\.[0-7]|DB[BWD](?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))$" },
        "limits": {
          "description": "Ordered by leaf_path, compared byte by byte.",
          "type": "array",
          "items": { "$ref": "#/$defs/limit" }
        },
        "value": { "$ref": "#/$defs/value" }
      },
      "allOf": [
        {
          "description": "A BOOL value is a boolean (ADR-0208 (d)).",
