{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recipe-editor:export-document:schema-version:1",
  "title": "Export document v1 of the recipe editor",
  "description": "This file is the source of truth of the export document (ADR-0019). api.md section 6 describes it. A new field needs schema_version 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exported_at",
    "exported_by",
    "loadable",
    "content_sha256",
    "machine",
    "recipe",
    "version",
    "types",
    "parameters"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "exported_at": { "$ref": "#/$defs/utc_time" },
    "exported_by": { "$ref": "#/$defs/login" },
    "loadable": { "type": "boolean" },
    "content_sha256": {
      "description": "Lower-case hex SHA-256 of the RFC 8785 canonical form of the hashed body.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine": { "$ref": "#/$defs/machine" },
    "recipe": { "$ref": "#/$defs/recipe" },
    "version": { "$ref": "#/$defs/version" },
    "types": {
      "description": "Ordered by id, compared byte by byte (api.md section 6.3).",
      "type": "array",
      "items": { "$ref": "#/$defs/type_entry" }
    },
    "parameters": {
      "description": "Ordered by unit_path, then tag (api.md section 6.3).",
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    }
  },
  "allOf": [
    {
      "description": "loadable is true only for an Approved version.",
      "if": {
        "required": ["version"],
        "properties": {
          "version": {
            "required": ["status"],
            "properties": { "status": { "const": "Retired" } }
          }
        }
      },
      "then": { "properties": { "loadable": { "const": false } } },
      "else": { "properties": { "loadable": { "const": true } } }
    },
    {
      "description": "An S7 address is required on S7_300 (A31).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "const": "S7_300" } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "s7_address": { "type": "string" } } }
          }
        }
      }
    },
    {
      "description": "An S7 address is not allowed on CodesysIec and TwinCat3 (A31).",
      "if": {
        "required": ["machine"],
        "properties": {
          "machine": {
            "required": ["plc_platform"],
            "properties": { "plc_platform": { "enum": ["CodesysIec", "TwinCat3"] } }
          }
        }
      },
      "then": {
        "properties": {
          "parameters": {
            "items": { "properties": { "s7_address": { "type": "null" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utc_time": {
      "description": "RFC 3339 time in UTC with whole seconds and the suffix Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "login": {
      "description": "Login of a user (domain-model.md section 2).",
      "type": "string",
      "pattern": "^[a-z0-9._-]{3,64}$"
    },
    "name_text": {
      "description": "A name at export time. Names are not in the hash.",
      "type": "string",
      "minLength": 1
    },
    "decimal_or_null": {
      "description": "Canonical decimal text of reliability.md section 4.4, or null.",
      "type": ["string", "null"],
      "pattern": "^(0|-?[1-9][0-9]*(\\.[0-9]*[1-9])?|-?0\\.[0-9]*[1-9])$"
    },
    "identifier_name": {
      "description": "Name of a struct or of a struct member (domain-model.md section 2).",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "type_ref": {
      "description": "The primitive name for a primitive without a length. A types[].id for every other type.",
      "anyOf": [
        {
          "enum": [
            "BOOL", "BYTE", "WORD", "DWORD", "LWORD",
            "SINT", "USINT", "INT", "UINT", "DINT", "UDINT", "LINT", "ULINT",
            "REAL", "LREAL", "CHAR", "WCHAR",
            "TIME", "LTIME", "DATE", "LDATE", "TIME_OF_DAY", "LTOD",
            "DATE_AND_TIME", "LDT", "DTL", "S5TIME"
          ]
        },
        { "$ref": "#/$defs/uuid" }
      ]
    },
    "value": {
      "description": "A ParameterValue tree. A leaf is a string or a boolean. A JSON number and null are not allowed.",
      "anyOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "plc_platform"],
      "properties": {
        "code": { "type": "string", "pattern": "^M[1-9][0-9]{0,6}$" },
        "name": { "$ref": "#/$defs/name_text" },
        "plc_platform": {
          "enum": ["CodesysIec", "TwinCat3", "S7_1200", "S7_1500", "S7_300"]
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_number", "name"],
      "properties": {
        "reference_number": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,49}$" },
        "name": { "$ref": "#/$defs/name_text" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "status", "approved_at", "approved_by"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["Approved", "Retired"] },
        "approved_at": { "$ref": "#/$defs/utc_time" },
        "approved_by": { "$ref": "#/$defs/login" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "upper": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_id"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier_name" },
        "type_id": { "$ref": "#/$defs/type_ref" }
      }
    },
    "type_entry": {
      "description": "One entry of types[]. element_type_id and dimensions exist only for Array. members exists only for Struct.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "revision", "kind", "string_length"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": ["string", "null"] },
        "revision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["Primitive", "Array", "Struct"] },
        "string_length": { "type": ["integer", "null"], "minimum": 1, "maximum": 16382 },
        "element_type_id": { "$ref": "#/$defs/type_ref" },
        "dimensions": {
          "description": "One to 3 dimensions (A38).",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "members": {
          "description": "Ordered by the member ordinal.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Primitive" } } },
          "then": {
            "properties": {
              "name": { "enum": ["STRING", "WSTRING"] },
              "revision": { "const": 1 },
              "string_length": { "type": "integer" }
            },
            "not": {
              "anyOf": [
                { "required": ["element_type_id"] },
                { "required": ["dimensions"] },
                { "required": ["members"] }
              ]
            }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Array" } } },
          "then": {
            "required": ["element_type_id", "dimensions"],
            "properties": {
              "name": { "type": "null" },
              "revision": { "const": 1 },
              "string_length": { "type": "null" }
            },
            "not": { "required": ["members"] }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "Struct" } } },
          "then": {
            "required": ["members"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier_name" },
              "string_length": { "type": "null" }
            },
            "not": {
              "anyOf": [
                { "required": ["element_type_id"] },
                { "required": ["dimensions"] }
              ]
            }
          }
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf_path", "min", "max", "max_length"],
      "properties": {
        "leaf_path": {
          "description": "LeafPath grammar of domain-model.md section 2.1.",
          "type": "string",
          "pattern": "^(\\.[A-Za-z_][A-Za-z0-9_]{0,63}|\\[-?[0-9]{1,10}(,-?[0-9]{1,10}){0,2}\\]|\\[\\*\\])*$"
        },
        "min": { "$ref": "#/$defs/decimal_or_null" },
        "max": { "$ref": "#/$defs/decimal_or_null" },
        "max_length": { "$ref": "#/$defs/decimal_or_null" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_path", "tag", "key", "name_en", "type_id", "s7_address", "limits", "value"],
      "properties": {
        "unit_path": {
          "description": "UnitPath: U and 1 to 5 segments, each 1 to 64 (A30).",
          "type": "string",
          "pattern": "^U([1-9]|[1-5][0-9]|6[0-4])(\\.([1-9]|[1-5][0-9]|6[0-4])){0,4}$"
        },
        "tag": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "key": { "$ref": "#/$defs/uuid" },
        "name_en": { "$ref": "#/$defs/name_text" },
        "type_id": { "$ref": "#/$defs/type_ref" },
        "s7_address": { "type": ["string", "null"] },
        "limits": {
          "description": "Ordered by leaf_path, compared byte by byte.",
          "type": "array",
          "items": { "$ref": "#/$defs/limit" }
        },
        "value": { "$ref": "#/$defs/value" }
      }
    }
  }
}
